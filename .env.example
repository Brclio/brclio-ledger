# GitHub fine-grained PAT: grant Contents read/write to this repository only.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_OWNER=Brclio
GITHUB_REPO=brclio-ledger
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data/ledger.json

# Preferred: labels mapped to salted scrypt verifiers. Generate interactively with: npm run hash-password
# Use a JSON object so multiple editors are supported.
LEDGER_PASSWORD_HASHES={"owner":"replace_with_generated_scrypt_verifier","editor":"replace_with_generated_scrypt_verifier"}

# Optional easier alternative (do not commit real values):
# LEDGER_PASSWORDS={"owner":"a-strong-password","editor":"another-strong-password"}

# At least 32 random characters. Changing it logs out all browsers.
SESSION_SECRET=replace_with_a_long_random_secret

# Optional session lifetime in seconds (default: 43200 / 12 hours).
# SESSION_TTL_SECONDS=43200

# Optional commit identity. If omitted, GitHub uses the token owner.
# GITHUB_COMMITTER_NAME=Brclio Ledger Bot
# GITHUB_COMMITTER_EMAIL=ledger@example.com
